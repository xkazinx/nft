# nft (github.com/xkazinx/nft) at kazin.dev/projects/nft: the web build, static (no
# server). Written by deploy/ubuntu/install.sh. Imported inside the kazin.dev site
# block (`import /etc/caddy/sites/kazin.dev.d/*.caddy`).
redir /projects/nft /projects/nft/ permanent

# The web build, with the prefix taken off; revalidated each visit (a new build
# keeps its names)
handle_path /projects/nft/* {
	root * /opt/nft/web
	header Cache-Control "no-cache"
	file_server
}
